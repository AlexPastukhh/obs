    "x": 10043.52873923612,
    "y": 1178.155336482905,
    "text": "HANDLERS WITH REQUIREMENTS"
  },
  {
    "line_id": "L-005",
    "group_id": "TG-004",
    "x": 5526.861869118933,
    "y": 5181.488618953608,
    "text": "NON Generic AuthorizationHandler"
  },
  {
    "line_id": "L-006",
    "group_id": "TG-005",
    "x": 14754.270011140014,
    "y": 1305.021365326872,
    "text": "BASIC,"
  },
  {
    "line_id": "L-007",
    "group_id": "TG-005",
    "x": 14754.270011140014,
    "y": 1305.021365326872,
    "text": "GLOBAL AUTHORIZATION"
  },
  {
    "line_id": "L-008",
    "group_id": "TG-006",
    "x": 10789.74456640815,
    "y": 4932.083917470715,
    "text": "why to not use context.fail everywhere, multiple handlers registered"
  },
  {
    "line_id": "L-009",
    "group_id": "TG-006",
    "x": 10789.74456640815,
    "y": 4932.083917470715,
    "text": "for one requirement"
  },
  {
    "line_id": "L-010",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "using Microsoft.AspNetCore.Authorization;"
  },
  {
    "line_id": "L-011",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "using System.Security.Claims;"
  },
  {
    "line_id": "L-012",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "public sealed class ScopeRequirementHandler : AuthorizationHandler<ScopeRequirement>"
  },
  {
    "line_id": "L-013",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "{"
  },
  {
    "line_id": "L-014",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "protected override Task HandleRequirementAsync(AuthorizationHandlerContext context, ScopeRequirement requirement)"
  },
  {
    "line_id": "L-015",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "{"
  },
  {
    "line_id": "L-016",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "if (HasScope(context.User, requirement.Scope))"
  },
  {
    "line_id": "L-017",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "context.Succeed(requirement);"
  },
  {
    "line_id": "L-018",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "return Task.CompletedTask; // do nothing => not satisfied"
  },
  {
    "line_id": "L-019",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "}"
  },
  {
    "line_id": "L-020",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "private static bool HasScope(ClaimsPrincipal user, string needed)"
  },
  {
    "line_id": "L-021",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "{"
  },
  {
    "line_id": "L-022",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "// gather all possible scope strings"
  },
  {
    "line_id": "L-023",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "var values = user.FindAll(\"scope\").Select(c => c.Value)"
  },
  {
    "line_id": "L-024",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": ".Concat(user.FindAll(\"scp\").Select(c => c.Value));"
  },
  {
    "line_id": "L-025",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "foreach (var v in values)"
  },
  {
    "line_id": "L-026",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "{"
  },
  {
    "line_id": "L-027",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "// handle both \"a b c\" and single-value"
  },
  {
    "line_id": "L-028",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "var scopes = v.Split(' ', StringSplitOptions.RemoveEmptyEntries);"
  },
  {
    "line_id": "L-029",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "if (scopes.Contains(needed, StringComparer.Ordinal))"
  },
  {
    "line_id": "L-030",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "return true;"
  },
  {
    "line_id": "L-031",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "}"
  },
  {
    "line_id": "L-032",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "return false;"
  },
  {
    "line_id": "L-033",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "}"
  },
  {
    "line_id": "L-034",
    "group_id": "TG-007",
    "x": 9520.170063169822,
    "y": 7444.60424484384,
    "text": "}"
  },
  {
    "line_id": "L-035",
    "group_id": "TG-008",
    "x": 10790.95060900991,
    "y": 6666.812974751127,
    "text": "scope claims"
  },
