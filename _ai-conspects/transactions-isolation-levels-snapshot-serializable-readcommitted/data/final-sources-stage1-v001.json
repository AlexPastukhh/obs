  },
  {
    "source_id": "T001",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "you can get all applied or all rolled back(atomicity)"
  },
  {
    "source_id": "T002",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "with any isolation level"
  },
  {
    "source_id": "T003",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "when reads are part of"
  },
  {
    "source_id": "T004",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "transaction"
  },
  {
    "source_id": "T005",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "when the query runs (linq/sql api to get smth)"
  },
  {
    "source_id": "T006",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "readcommited"
  },
  {
    "source_id": "T007",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "isolaton levels"
  },
  {
    "source_id": "T008",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "how can help to avoid inconsistency"
  },
  {
    "source_id": "T009",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "with multiple queries"
  },
  {
    "source_id": "T010",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "with snapshot/serializable"
  },
  {
    "source_id": "T011",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "so readcommited is ok when"
  },
  {
    "source_id": "T012",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "we cant have some state changes from"
  },
  {
    "source_id": "T013",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "other transaction"
  },
  {
    "source_id": "T014",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "like when we have some"
  },
  {
    "source_id": "T015",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "e tags that will prevent"
  },
  {
    "source_id": "T016",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "update with incons stae"
  },
  {
    "source_id": "T017",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "like when we change e tag on some"
  },
  {
    "source_id": "T018",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "children changes"
  },
  {
    "source_id": "T019",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "other isolaton levels, default"
  },
  {
    "source_id": "T020",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "snapshot,"
  },
  {
    "source_id": "T021",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "snapshot exception with code"
  },
  {
    "source_id": "T022",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "when you update/delete/insert"
  },
  {
    "source_id": "T023",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "based on old data"
  },
  {
    "source_id": "T024",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "why serializable"
  },
  {
    "source_id": "T025",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "reading your own"
  },
  {
    "source_id": "T026",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "uncommited changes"
  },
  {
    "source_id": "T027",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "dbcontext about transactions strategies"
  },
  {
    "source_id": "T028",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "readuncommited"
  },
  {
    "source_id": "T029",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "so i have some scenarios when i may need some"
  },
  {
    "source_id": "T030",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "transaction or when i may think that i need them"
  },
  {
    "source_id": "T031",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "1 when i query something from db, look at it and chose to change it"
  },
  {
    "source_id": "T032",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "but at the same time i may have another request that"
  },
  {
    "source_id": "T033",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "changes the same thing"
  },
  {
    "source_id": "T034",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "dont need manual transaction, can configure rowversion or"
  },
  {
    "source_id": "T035",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "isconcurencytoken and ef will throw exceptions"
  },
  {
    "source_id": "T036",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "2 when i have multiple queries to get data"
  },
  {
    "source_id": "T037",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "may need transaction with isolationlevel snapshot"
  },
  {
    "source_id": "T038",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "3 when i have some possible nesting of methods that mutate"
  },
  {
    "source_id": "T039",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "queried entity and each may call savechanges"
  },
  {
    "source_id": "T040",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "one savechanges succeds another fails and we get inconsistency"
  },
  {
    "source_id": "T041",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "need to wrap everything in one transaction with any isolatoin level but usually with default"
  },
  {
    "source_id": "T042",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "4 when i have some database.executesql  or other like dbset.executeupdate (that is"
  },
  {
    "source_id": "T043",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "linq based but everything else like executesql) - they all dont care about savechanges"
  },
  {
    "source_id": "T044",
    "type": "text_label",
    "region": "R01",
    "status": "closed",
    "file": "",
    "text": "so if i want them to be in a traqnsaction i need to create transaction"
  },
  {
    "source_id": "T045",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "readcommited"
  },
  {
    "source_id": "T046",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "repeatableread vs serialized"
  },
  {
    "source_id": "T047",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "repeatableread vs serialized"
  },
  {
    "source_id": "T048",
    "type": "text_label",
    "region": "R02",
    "status": "closed",
    "file": "",
    "text": "repeatableread"
  },
  {
    "source_id": "T049",
    "type": "text_label",
    "region": "R03",
    "status": "closed",
    "file": "",
    "text": "isolation level"
  },
  {
    "source_id": "T050",
    "type": "text_label",
    "region": "R03",
    "status": "closed",
    "file": "",
    "text": "in manual retries from same tranaction"
  },
  {
    "source_id": "T051",
    "type": "text_label",
    "region": "R03",
    "status": "closed",
    "file": "",
    "text": "using savepoints cases"
  },
  {
    "source_id": "T052",
    "type": "text_label",
    "region": "R03",
    "status": "closed",
    "file": "",
    "text": "when we use execute (not in transaction)"
  },
  {
    "source_id": "T053",
    "type": "text_label",
    "region": "R03",
    "status": "closed",
    "file": "",
    "text": "method"
  },
  {
    "source_id": "T054",
    "type": "text_label",
    "region": "R03",
    "status": "closed",
    "file": "",
    "text": "and there is some ambigous outcome of"
  },
  {
    "source_id": "T055",
    "type": "text_label",
    "region": "R03",
    "status": "closed",
    "file": "",
    "text": "the transaction"
  },
  {
    "source_id": "T056",
    "type": "text_label",
    "region": "R03",
    "status": "closed",
    "file": "",
    "text": "by default - we will retry"
  },
  {
    "source_id": "T057",
    "type": "text_label",
    "region": "R03",
    "status": "closed",
    "file": "",
    "text": "!!!"
  },
  {
    "source_id": "T058",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "locks with readcommited,"
  },
  {
    "source_id": "T059",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "rcsi,serializable"
  },
  {
    "source_id": "T060",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "when locks are acquired"
  },
  {
    "source_id": "T061",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "on start of transaction"
  },
  {
    "source_id": "T062",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "or on data touch?"
  },
  {
    "source_id": "T063",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "read commited"
  },
  {
    "source_id": "T064",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "rcsi"
  },
  {
    "source_id": "T065",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "serializable"
  },
  {
    "source_id": "T066",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "serializable protects the"
  },
  {
    "source_id": "T067",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "range relevant to predicate"
  },
  {
    "source_id": "T068",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "when both trans need to have isolation"
  },
  {
    "source_id": "T069",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "serializable"
  },
  {
    "source_id": "T070",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "to keep invariants"
  },
  {
    "source_id": "T071",
    "type": "text_label",
    "region": "R04",
    "status": "closed",
    "file": "",
    "text": "!!!"
  }
]