    "y": 1237.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-028",
    "text": "/// 3) server preference order (SupportedByPreference)",
    "x": 10.0,
    "y": 1262.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-029",
    "text": "/// 4) header order as a final tie-breaker (stable by index)",
    "x": 10.0,
    "y": 1287.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-030",
    "text": "/// </summary>",
    "x": 10.0,
    "y": 1312.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-031",
    "text": "public static bool TrySelect(",
    "x": 10.0,
    "y": 1337.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-032",
    "text": "StringValues acceptHeader,",
    "x": 10.0,
    "y": 1362.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-033",
    "text": "out NegotiationResult? result)",
    "x": 10.0,
    "y": 1387.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-034",
    "text": "{",
    "x": 10.0,
    "y": 1412.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-035",
    "text": "result = null;",
    "x": 10.0,
    "y": 1437.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-036",
    "text": "// Missing Accept => treat as */* (client accepts anything)",
    "x": 10.0,
    "y": 1487.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-037",
    "text": "if (StringValues.IsNullOrEmpty(acceptHeader))",
    "x": 10.0,
    "y": 1512.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-038",
    "text": "{",
    "x": 10.0,
    "y": 1537.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-039",
    "text": "// choose your default representation here",
    "x": 10.0,
    "y": 1562.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-040",
    "text": "var defaultMt = \"application/vnd.marvin.author.friendly+json\";",
    "x": 10.0,
    "y": 1587.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-041",
    "text": "result = BuildResult(defaultMt);",
    "x": 10.0,
    "y": 1612.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-042",
    "text": "return true;",
    "x": 10.0,
    "y": 1637.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-043",
    "text": "}",
    "x": 10.0,
    "y": 1662.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-044",
    "text": "if (!MediaTypeHeaderValue.TryParseList(acceptHeader, out var parsedList))",
    "x": 10.0,
    "y": 1712.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-045",
    "text": "{",
    "x": 10.0,
    "y": 1737.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-046",
    "text": "return false; // invalid syntax -> caller should return 400 ProblemDetails",
    "x": 10.0,
    "y": 1762.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-047",
    "text": "}",
    "x": 10.0,
    "y": 1787.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-048",
    "text": "// Build candidates from Accept values",
    "x": 10.0,
    "y": 1837.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-049",
    "text": "var candidates = parsedList",
    "x": 10.0,
    "y": 1862.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-050",
    "text": ".Select((mt, index) => new Candidate(mt, index))",
    "x": 10.0,
    "y": 1887.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-051",
    "text": ".Where(c => c.Q > 0) // q=0 means \"not acceptable\"",
    "x": 10.0,
    "y": 1912.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-052",
    "text": ".ToList();",
    "x": 10.0,
    "y": 1937.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-053",
    "text": "if (candidates.Count == 0)",
    "x": 10.0,
    "y": 1987.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-054",
    "text": "{",
    "x": 10.0,
    "y": 2012.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-055",
    "text": "return false;",
    "x": 10.0,
    "y": 2037.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-056",
    "text": "}",
    "x": 10.0,
    "y": 2062.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-057",
    "text": "// For each Accept candidate, find best supported match based on:",
    "x": 10.0,
    "y": 2112.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-058",
    "text": "// - exact match in SupportedByPreference",
    "x": 10.0,
    "y": 2137.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-059",
    "text": "// - or \"application/*\" / \"*/*\" wildcard",
    "x": 10.0,
    "y": 2162.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-060",
    "text": "var supportedMatches = new List<SupportedMatch>();",
    "x": 10.0,
    "y": 2187.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-061",
    "text": "foreach (var c in candidates)",
    "x": 10.0,
    "y": 2237.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-062",
    "text": "{",
    "x": 10.0,
    "y": 2262.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-063",
    "text": "foreach (var supported in SupportedByPreference)",
    "x": 10.0,
    "y": 2287.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-064",
    "text": "{",
    "x": 10.0,
    "y": 2312.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-065",
    "text": "if (Matches(c, supported))",
    "x": 10.0,
    "y": 2337.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-066",
    "text": "{",
    "x": 10.0,
    "y": 2362.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-067",
    "text": "supportedMatches.Add(new SupportedMatch(",
    "x": 10.0,
    "y": 2387.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-068",
    "text": "supportedMediaType: Normalize(supported),",
    "x": 10.0,
    "y": 2412.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-069",
    "text": "q: c.Q,",
    "x": 10.0,
    "y": 2437.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-070",
    "text": "specificity: c.Specificity,",
    "x": 10.0,
    "y": 2462.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-071",
    "text": "supportedPreferenceRank: Array.IndexOf(SupportedByPreference, supported),",
    "x": 10.0,
    "y": 2487.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-072",
    "text": "acceptHeaderIndex: c.Index));",
    "x": 10.0,
    "y": 2512.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-073",
    "text": "}",
    "x": 10.0,
    "y": 2537.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-074",
    "text": "}",
    "x": 10.0,
    "y": 2562.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-075",
    "text": "}",
    "x": 10.0,
    "y": 2587.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-076",
    "text": "if (supportedMatches.Count == 0)",
    "x": 10.0,
    "y": 2637.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-077",
    "text": "{",
    "x": 10.0,
    "y": 2662.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-078",
    "text": "// No overlap between Accept and what we can produce -> 406 scenario",
    "x": 10.0,
    "y": 2687.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-079",
    "text": "return false;",
    "x": 10.0,
    "y": 2712.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-080",
    "text": "}",
    "x": 10.0,
    "y": 2737.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-081",
    "text": "var winner = supportedMatches",
    "x": 10.0,
    "y": 2787.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-082",
    "text": ".OrderByDescending(m => m.Q)",
    "x": 10.0,
    "y": 2812.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-083",
    "text": ".ThenByDescending(m => m.Specificity)",
    "x": 10.0,
    "y": 2837.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-084",
    "text": ".ThenBy(m => m.SupportedPreferenceRank)",
    "x": 10.0,
    "y": 2862.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-085",
    "text": ".ThenBy(m => m.AcceptHeaderIndex)",
    "x": 10.0,
    "y": 2887.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-086",
    "text": ".First();",
    "x": 10.0,
    "y": 2912.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-087",
    "text": "result = BuildResult(winner.SupportedMediaType);",
    "x": 10.0,
    "y": 2962.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-088",
    "text": "return true;",
    "x": 10.0,
    "y": 2987.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-089",
    "text": "}",
    "x": 10.0,
    "y": 3012.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-090",
    "text": "private static NegotiationResult BuildResult(string mediaType)",
    "x": 10.0,
    "y": 3062.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-091",
    "text": "{",
    "x": 10.0,
    "y": 3087.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-092",
    "text": "// your course logic: include links if subtype ends with \"hateoas\"",
    "x": 10.0,
    "y": 3112.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-093",
    "text": "var includeLinks = mediaType.Contains(\"hateoas\", StringComparison.OrdinalIgnoreCase);",
    "x": 10.0,
    "y": 3137.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-094",
    "text": "// derive \"primary\" type similar to course:",
    "x": 10.0,
    "y": 3187.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-095",
    "text": "// application/vnd.marvin.author.full.hateoas+json -> vnd.marvin.author.full",
    "x": 10.0,
    "y": 3212.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-096",
    "text": "// application/vnd.marvin.author.friendly+json -> vnd.marvin.author.friendly",
    "x": 10.0,
    "y": 3237.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
  {
    "label_id": "L-097",
    "text": "// application/json -> application",
    "x": 10.0,
    "y": 3262.233,
    "font_size": "20px",
    "fill": "#d3d3d3"
  },
