{
	"nodes":[
		{"id":"6c520c4d4aadbb7d","type":"text","text":"что страшно","x":220,"y":-280,"width":250,"height":60},
		{"id":"37bf61147abb6e73","type":"text","text":"что приятно, что доставляет удовольствие","x":-60,"y":-280,"width":250,"height":60},
		{"id":"ec3a24542ca15bce","type":"text","text":"что неизвестно","x":250,"y":-80,"width":250,"height":60},
		{"id":"0130a57b62b668b4","type":"text","text":"что интересно","x":250,"y":-140,"width":250,"height":60},
		{"id":"36a60754c285f706","type":"text","text":"на что это похоже?","x":-450,"y":-280,"width":250,"height":60},
		{"id":"a185cfe529f6157b","type":"text","text":"что там приятно, что доставляет удовольствие","x":-640,"y":-94,"width":250,"height":60},
		{"id":"718bf7d95ec541d6","type":"text","text":"что там страшно","x":-500,"y":20,"width":250,"height":60},
		{"id":"d11dc4a998e4e796","type":"text","text":"что интересно","x":-250,"y":-94,"width":250,"height":60},
		{"id":"8469ab47d0259872","type":"text","text":"метро","x":-790,"y":234,"width":250,"height":60},
		{"id":"f1c58247659ad769","type":"text","text":"российский сеттинг","x":-1160,"y":433,"width":250,"height":60},
		{"id":"88c5f39154931da2","type":"text","text":"шизофракции","x":-860,"y":443,"width":250,"height":50},
		{"id":"fe014b128ac218f1","type":"text","text":"60 сек","x":-1171,"y":608,"width":250,"height":60},
		{"id":"93903c5c56c92789","type":"text","text":"смерть повсюду, мутанты, брошенные станции с трупами и мутантами, звуки","x":-635,"y":333,"width":250,"height":135},
		{"id":"ef32093fe405fb0f","type":"text","text":"выживать в укрытии","x":144,"y":595,"width":250,"height":60},
		{"id":"00aa81f2cee7b9de","type":"text","text":"ПОИНТ: Неизвестность\n","x":473,"y":606,"width":250,"height":50},
		{"id":"dc80f6ac2abe2f02","type":"text","text":"Ты можешь контролировать вылазку, но не будешь знать что в убежище, можешь контролировать убежище, но не будешь знать как проходит вылазка","x":819,"y":782,"width":250,"height":214},
		{"id":"16b7b8ee7c42fb06","type":"text","text":"Жестокость","x":1014,"y":535,"width":250,"height":60},
		{"id":"30b8e10a9412ae9a","type":"text","text":"совершать вылазки","x":369,"y":689,"width":250,"height":60},
		{"id":"862e622a8e6c847b","type":"text","text":"Рандомные хуйни и монстры ","x":544,"y":859,"width":250,"height":60},
		{"id":"c040da7a02b5abd2","type":"text","text":" возможно даже будет дано какое то большое время до апокалипсиса","x":-60,"y":772,"width":250,"height":117},
		{"id":"bf3427a0ef7a9f35","type":"text","text":"собрать вещи и выбрать укрытие","x":244,"y":771,"width":250,"height":60},
		{"id":"2b465b7735ad8f34","type":"text","text":"один сценарий\\сложность : есть день на подготовку, другой - есть год","x":-160,"y":970,"width":250,"height":119},
		{"id":"8ae5b730e53e6212","type":"text","text":"60 секунд от первого лица, 3д. ","x":348,"y":333,"width":250,"height":88},
		{"id":"a7afab31e95c6c1e","type":"text","text":"дают подготовиться","x":-1328,"y":811,"width":250,"height":60},
		{"id":"e769c701502ff88b","type":"text","text":"ПОДГОТОВИТЬСя понять что примерно происходит,","x":-160,"y":548,"width":250,"height":94},
		{"id":"dd3f53a80cb8c0c3","type":"text","text":"избавляться от трупов","x":-1453,"y":1240,"width":250,"height":60},
		{"id":"45fcdb443dec9bf2","type":"text","text":"возможность пропускать время (возм мех когда не по плану что то пошло, тогда прокрут кончается)","x":-1328,"y":1440,"width":250,"height":160},
		{"id":"d07c6be497952b70","type":"text","text":"прятать тела ","x":-995,"y":1440,"width":250,"height":60},
		{"id":"d69ca2d0e500b459","type":"text","text":"персонаж умирает, ты можешь начать играть за другого в тот момент когда этот другой пропал из виду того, который умирает, все что произошло с первым записывается и ты в теории за другого можешь вклиниться в \"сейв\" и спасти первого","x":-640,"y":1440,"width":250,"height":320},
		{"id":"4685a1b69ed039d5","type":"text","text":"каннибализм, проституция, грабительство","x":-1171,"y":1240,"width":250,"height":80},
		{"id":"aba10c18bd5cb55b","type":"text","text":"следить за рационом, за весом когда передвигаешься с места на место","x":-921,"y":1570,"width":250,"height":110},
		{"id":"636e7a2afa24240f","type":"text","text":"можешь пометить, какие предметы тебя интересуют, можешь пометить что покупаешь краденое(мб дополнительно у тебя есть платежеспособность благодаря которой больше людей будут тебе приходить продавать)","x":-640,"y":1910,"width":250,"height":340},
		{"id":"fee78dcd2faa12bc","type":"text","text":"износы, после износа отторжение к м, есть вероятность мужененавистничества","x":-890,"y":1840,"width":250,"height":140},
		{"id":"09e8567927f055dd","type":"text","text":"драгс, произво и продажа","x":-1120,"y":1760,"width":250,"height":60},
		{"id":"276d9c7f5a792466","type":"text","text":"Твои преступления могут стать публичными","x":-1929,"y":1676,"width":250,"height":60},
		{"id":"18777bc17c6261e3","type":"text","text":"ОЧАГИ - правительство может остаться, военные могут спасти","x":-1918,"y":1481,"width":250,"height":78},
		{"id":"b9c7b21213f2aedd","type":"text","text":"Свидетели преступлений и хуйни могут рассказать про тебя другим и ты можешь рассказать другим про что то ","x":-1620,"y":1372,"width":250,"height":137},
		{"id":"65ce97ed3f591584","type":"text","text":"Нужно избавиться от свидетелей, или сделать так чтобы они очень хорошо к тебе относились или вы были повязаны","x":-1804,"y":1840,"width":250,"height":160},
		{"id":"f9002fb51dca0860","type":"text","text":"Пытки","x":-1620,"y":2040,"width":250,"height":60},
		{"id":"dbf72868fe9a26d2","type":"text","text":"мб не прямая механика пыток, типо просто любого можно ударить и пленного в т ч и сам игрок должен к этому прийти, ещё ачивку при первом пыточном ударе можно дать чтоб совсем очевидно стало что так можно","x":-1756,"y":2225,"width":250,"height":275},
		{"id":"c7c514d1f6c77603","type":"text","text":"характеристики персонажей","x":-1280,"y":2363,"width":250,"height":60},
		{"id":"c06a9ecbd4d3cbe1","type":"text","text":"свои характеристики известны все,большинство хар группы тоже, но иногда нужно знать больше, могут быть секреты","x":-1441,"y":2568,"width":250,"height":172},
		{"id":"c9c59a8b46296750","type":"text","text":"","x":-1137,"y":2588,"width":250,"height":60},
		{"id":"31be6b5418ffe824","type":"text","text":"интереснее говно в котором можно что от новое узнать мб(историческое там, вся хуйня)","x":-1012,"y":2820,"width":250,"height":134},
		{"id":"58097e7b29681d15","type":"text","text":"Тайники, заначки","x":-1405,"y":2140,"width":250,"height":60},
		{"id":"bdd27706f8aa1c22","type":"text","text":"готовишься годами, качаешь хар, выбираешь город, находишь друзей","x":169,"y":1024,"width":250,"height":96},
		{"id":"8d61ede9d1b78406","type":"text","text":"можешь сойти с ума раньше времени есть слишком много будешь уделять сил апок паранойе","x":-81,"y":1240,"width":250,"height":142},
		{"id":"08f21fbe5022dff9","type":"text","text":"модешь выбрать город(у нег есть характеристики, преступность там, всякие ключевые здания, население, стратегическая значимость, состоятельность населения и тд)","x":427,"y":1269,"width":250,"height":251},
		{"id":"773e814f81367f6c","type":"text","text":"характ города могут меняться","x":419,"y":1647,"width":250,"height":67},
		{"id":"5a0f2a676d8c2c99","type":"text","text":"КАК понимать что происходит?","x":-540,"y":626,"width":250,"height":60},
		{"id":"ef64bb76bb3f36d6","type":"text","text":"Как должна выглядеть игра","x":-106,"y":303,"width":250,"height":60},
		{"id":"a52da606775a7a64","type":"text","text":"работаешь, можешь откладывать, покупать всякую херню","x":760,"y":1251,"width":250,"height":111},
		{"id":"012a0226773245c5","type":"text","text":"есть тенденция развития характ перса, ","x":90,"y":1460,"width":250,"height":60},
		{"id":"fbb93915bafe555e","type":"text","text":"Могут еще уйти со своего места ","x":-164,"y":2243,"width":250,"height":60},
		{"id":"482d5de9e6819908","type":"text","text":"Базы выживших, которые могут быть униччтожены в зависимости от обстоятельств","x":-24,"y":1980,"width":250,"height":148}
	],
